@implements IDisposable
@using NocMonitor.Data.Entities
@using NocMonitor.Web.Services
@inject SyncLogService SyncLogService
@inject SyncLogNotifier Notifier
@inject HpvSyncService HpvSyncService
@inject ILogger<SyncLogPanel> Logger

<div class="sync-log">
    <button type="button" class="sync-log-trigger" title="Sync HPVs/VMs now"
            aria-label="Sync HPVs/VMs now" disabled="@_syncing"
            @onclick="SyncNowAsync">
        <span class="@(_syncing ? "sync-log-icon sync-log-icon-spinning" : "sync-log-icon")" aria-hidden="true">⟳</span>
    </button>
    <button type="button" class="sync-log-trigger" title="HPV/VM sync log"
            aria-label="HPV/VM sync log" aria-haspopup="dialog" aria-expanded="@_open"
            @onclick="ToggleOpenAsync">
        <span class="sync-log-icon" aria-hidden="true">🕘</span>
        @if (_unacknowledgedCount > 0)
        {
            <span class="sync-log-badge">@(_unacknowledgedCount > 99 ? "99+" : _unacknowledgedCount.ToString())</span>
        }
    </button>

    @if (_open)
    {
        <div class="sync-log-panel" role="dialog" aria-label="HPV/VM sync log">
            <div class="sync-log-tabs" role="tablist">
                <button type="button" class="@TabClass(SyncLogTab.New)" role="tab" aria-selected="@(_tab == SyncLogTab.New)"
                        @onclick="() => SetTabAsync(SyncLogTab.New)">
                    New @(_unacknowledgedCount > 0 ? $"({_unacknowledgedCount})" : "")
                </button>
                <button type="button" class="@TabClass(SyncLogTab.History)" role="tab" aria-selected="@(_tab == SyncLogTab.History)"
                        @onclick="() => SetTabAsync(SyncLogTab.History)">
                    History
                </button>
                <button type="button" class="sync-log-close" title="Close" aria-label="Close sync log"
                        @onclick="Close">✕</button>
            </div>

            <div class="sync-log-body">
                @if (_tab == SyncLogTab.New)
                {
                    @if (_unacknowledged is null)
                    {
                        <p class="md-body-medium sync-log-status">Loading...</p>
                    }
                    else if (_unacknowledged.Count == 0)
                    {
                        <div class="sync-log-empty">
                            <span class="sync-log-empty-icon" aria-hidden="true">✓</span>
                            <p class="md-body-medium">All caught up.</p>
                        </div>
                    }
                    else
                    {
                        <ul class="sync-log-list">
                            @foreach (var entry in _unacknowledged)
                            {
                                <li class="sync-log-item">
                                    <button type="button" class="sync-log-check" title="Mark as seen"
                                            aria-label="Mark @(EventLabel(entry.EventType).ToLowerInvariant()) of @entry.HostName as seen"
                                            @onclick="() => AcknowledgeAsync(entry.Id)">✓</button>
                                    @EntryBody(entry)
                                </li>
                            }
                        </ul>
                    }
                }
                else
                {
                    @if (_history is null)
                    {
                        <p class="md-body-medium sync-log-status">Loading...</p>
                    }
                    else if (_history.Count == 0)
                    {
                        <p class="md-body-medium sync-log-status"><em>No entries yet.</em></p>
                    }
                    else
                    {
                        <ul class="sync-log-list">
                            @foreach (var entry in _history)
                            {
                                <li class="sync-log-item sync-log-item-readonly">
                                    @EntryBody(entry)
                                </li>
                            }
                        </ul>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    private enum SyncLogTab { New, History }

    private bool _open;
    private bool _syncing;
    private SyncLogTab _tab = SyncLogTab.New;
    private List<SyncLogEntry>? _unacknowledged;
    private List<SyncLogEntry>? _history;
    private int _unacknowledgedCount;

    protected override async Task OnInitializedAsync()
    {
        await RefreshCountAsync();
        Notifier.Changed += OnChanged;
    }

    private async Task RefreshCountAsync() =>
        _unacknowledgedCount = await SyncLogService.GetUnacknowledgedCountAsync();

    // Potentially called from the sync's background thread: InvokeAsync
    // marshals back to the circuit's sync context, same pattern as Home.razor.
    // It's also the only thing that refreshes the panel after a click right
    // here (SyncLogService.AcknowledgeAsync fires this same event) — avoids
    // duplicating the refresh in the click handler itself.
    // [PERF audit]: same reasoning as Home.OnChanged - Debug level, this can
    // fire up to 1/s and Information-level logging at that rate is just
    // noise once the underlying issue is fixed.
    private void OnChanged()
    {
        var raisedAt = DateTime.Now;
        Logger.LogDebug("[PERF] SyncLogPanel.OnChanged raised at {Time:HH:mm:ss.ffffff}", raisedAt);

        _ = InvokeAsync(async () =>
        {
            var dispatchedAt = DateTime.Now;
            Logger.LogDebug(
                "[PERF] SyncLogPanel.OnChanged dispatched at {Time:HH:mm:ss.ffffff} (queue wait={QueueWaitMs}ms)",
                dispatchedAt, (dispatchedAt - raisedAt).TotalMilliseconds);

            var sw = System.Diagnostics.Stopwatch.StartNew();
            await RefreshCountAsync();
            var tCount = sw.ElapsedMilliseconds;
            if (_open)
                await LoadTabAsync();
            var tTab = sw.ElapsedMilliseconds;
            StateHasChanged();
            Logger.LogDebug(
                "[PERF] SyncLogPanel.OnChanged done: refreshCount={CountMs}ms loadTab={TabMs}ms total={TotalMs}ms",
                tCount, tTab - tCount, sw.ElapsedMilliseconds);
        });
    }

    // Same RunSyncAsync used by the "Sync now" button on /hosts, so you don't
    // have to leave the dashboard/header. If the run adds/deactivates
    // anything, HpvSyncService already calls Notifier.NotifyChanged() (OnChanged
    // above) — the StateHasChanged below is only for the spinning icon.
    //
    // try/finally around _syncing: same defense-in-depth reasoning as
    // HostsPage.SyncNowAsync — this icon must never get stuck spinning forever.
    private async Task SyncNowAsync()
    {
        var startedAt = DateTime.Now;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        _syncing = true;
        StateHasChanged();

        try
        {
            await HpvSyncService.RunSyncAsync(CancellationToken.None);
        }
        finally
        {
            _syncing = false;
            StateHasChanged();
        }

        Logger.LogInformation(
            "[PERF] SyncNowAsync started={StartedAt:HH:mm:ss.ffffff} total={TotalMs}ms",
            startedAt, sw.ElapsedMilliseconds);
    }

    private async Task ToggleOpenAsync()
    {
        var startedAt = DateTime.Now;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        _open = !_open;
        if (_open)
            await LoadTabAsync();

        Logger.LogInformation(
            "[PERF] ToggleOpenAsync started={StartedAt:HH:mm:ss.ffffff} total={TotalMs}ms",
            startedAt, sw.ElapsedMilliseconds);
    }

    private void Close() => _open = false;

    private async Task SetTabAsync(SyncLogTab tab)
    {
        var startedAt = DateTime.Now;
        var sw = System.Diagnostics.Stopwatch.StartNew();

        _tab = tab;
        await LoadTabAsync();

        Logger.LogInformation(
            "[PERF] SetTabAsync({Tab}) started={StartedAt:HH:mm:ss.ffffff} total={TotalMs}ms",
            tab, startedAt, sw.ElapsedMilliseconds);
    }

    private async Task LoadTabAsync()
    {
        if (_tab == SyncLogTab.New)
            _unacknowledged = await SyncLogService.GetUnacknowledgedAsync();
        else
            _history = await SyncLogService.GetAllAsync();
    }

    private async Task AcknowledgeAsync(long id)
    {
        var startedAt = DateTime.Now;
        Logger.LogInformation("[PERF] AcknowledgeAsync({Id}) click handler started={StartedAt:HH:mm:ss.ffffff}", id, startedAt);
        await SyncLogService.AcknowledgeAsync(id);
    }

    private string TabClass(SyncLogTab tab) => tab == _tab ? "active" : "";

    private RenderFragment EntryBody(SyncLogEntry entry) => @<div class="sync-log-item-text">
        <span class="sync-log-event sync-log-event-@EventClass(entry.EventType)">@EventLabel(entry.EventType)</span>
        <span class="sync-log-name">@entry.HostName</span>
        <span class="sync-log-type">@TypeLabel(entry.Type)</span>
        <span class="sync-log-time md-body-small">@FormatTimestamp(entry.Timestamp)</span>
    </div>;

    private static string EventLabel(SyncEventType type) => type switch
    {
        SyncEventType.Added => "Added",
        SyncEventType.Deactivated => "Deactivated",
        _ => type.ToString(),
    };

    private static string EventClass(SyncEventType type) => type.ToString().ToLowerInvariant();

    private static string TypeLabel(HostType type) => type switch
    {
        HostType.Hpv => "HPV",
        HostType.Vm => "VM",
        _ => type.ToString(),
    };

    private static string FormatTimestamp(DateTime utc) => utc.ToLocalTime().ToString("dd/MM/yyyy HH:mm");

    public void Dispose() => Notifier.Changed -= OnChanged;
}
