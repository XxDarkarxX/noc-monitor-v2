# Copy this file to `.env` and fill in real values.
# `.env` itself is gitignored and must NEVER be committed.

# SQLite path inside the container. Matches the `noc-monitor-data` named
# volume mounted at /app/data in docker-compose.yml - don't change the path
# unless you also change the volume mount.
ConnectionStrings__NocMonitorDb=Data Source=/app/data/nocmonitor.db

# Discord webhook used for down/recovered alerts (see DiscordAlertSender.cs).
# NOTE: the key is "DiscordWebhook", not "DiscordWebhookUrl" - the app reads
# configuration["Alerts:DiscordWebhook"] exactly, so a typo here means alerts
# silently stop firing (only a warning in the logs, no error).
Alerts__DiscordWebhook=https://discord.com/api/webhooks/REPLACE_ME

# Base URL of the internal HPV/VM API used by the weekly sync (HpvSyncService).
# If left empty/unset, the sync just skips its run with a warning instead of
# failing.
HpvApi__BaseUrl=http://REPLACE_ME:8000
